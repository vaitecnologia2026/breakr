    {
      "parameters": {
        "jsCode": "const p = $('Prepara Envio WhatsApp').item.json;\nconst pays = ($('Busca Cobranca Asaas').item.json.data) || [];\nlet linkCobranca = '';\nfor (const it of pays) { if (it && it.invoiceUrl) { linkCobranca = it.invoiceUrl; break; } }\nconst content = `Olá, ${p.nome}! Tudo bem?\\n\\nSegue o seu contrato para assinatura e a cobrança para pagamento:\\n\\n📄 Contrato (assinar): ${p.linkContrato}\\n💳 Cobrança (boleto/PIX): ${linkCobranca}\\n\\nQualquer dúvida, estamos à disposição. Atenciosamente, Equipe Breakr.`;\nreturn [{ json: { phone: p.phone, content, nome: p.nome, linkContrato: p.linkContrato, linkCobranca } }];"
      },
