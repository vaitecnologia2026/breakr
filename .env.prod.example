# Copie para .env e preencha. NUNCA comitar o .env real.
# ----- Postgres (interno do docker-compose.prod) -----
POSTGRES_USER=breakr
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=breakr_os
# ----- API -----
JWT_SECRET=troque-por-um-segredo-aleatorio-forte
JWT_EXPIRES=1d
# Produção atual: front na Vercel + domínio próprio (lista separada por vírgula).
CORS_ORIGIN=https://breakr.vaitecnologia.com.br,https://breakr-rosy.vercel.app
# ----- Web (embutido NO BUILD — precisa ser a URL pública da API) -----
# Na Vercel, defina VITE_API_URL = URL pública HTTPS da API (Caddy no VPS):
VITE_API_URL=https://api-breakr.vaitecnologia.com.br
