# Copie para ".env" e ajuste. NUNCA comite o .env real (já está no .gitignore).

# URL alvo dos testes.
#  • Produção:  https://breakr.vaitecnologia.com.br
#  • Local:     http://localhost:5173  (front rodando em dev)
BASE_URL=https://breakr.vaitecnologia.com.br

# Conta usada para logar (ADMIN ou SUPERADMIN). O campo de login é "Usuário".
BREAKR_USUARIO=super@breakr.com
BREAKR_SENHA=troque-aqui

# (Opcional) Código do cliente de teste para os specs do portal (Bloco 6 e 8).
# Pegue na tela Clientes, coluna "Código / Portal" (ex.: CLI-XXXXXXXX).
BREAKR_PORTAL_CODIGO=
