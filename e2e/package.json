{
  "name": "breakr-testes-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E (Playwright) da nova ferramenta Breakr — espelham o CHECKLIST-TESTES-BREAKR.html, simulando um usuário real. Projeto ISOLADO: não importa nem altera o código do app.",
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "playwright test",
    "test:smoke": "playwright test smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:leitura": "playwright test --grep @leitura",
    "test:escrita": "playwright test --grep @escrita",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.5"
  }
}
