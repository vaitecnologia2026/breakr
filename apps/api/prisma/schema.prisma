// Schema Prisma — Breakr OS (Fase 0 — Fundacao / Nucleo)
// Referencia: docs/escopo/02-modelo-de-dados.md e docs/escopo/03-motor-de-automacao.md
// Sistema single-tenant (so Breakr) — sem empresa_id.
// Enums devem espelhar packages/shared/src/index.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS (espelham @breakr/shared)
// ============================================================

/// Cargos (definem permissoes e o painel "Hoje & Atrasados")
enum Cargo {
  SUPERADMIN
  ADMIN
  COMERCIAL
  CS
  ESTRATEGISTA
  COPYWRITER
  DESIGNER
  EDITOR_VIDEO
  GESTOR_TRAFEGO
  FINANCEIRO
  JURIDICO
}

/// Funcao do usuario dentro de um squad (base da atribuicao automatica)
enum FuncaoSquad {
  CS
  ESTRATEGISTA
  COPYWRITER
  DESIGNER
  EDITOR_VIDEO
  GESTOR_TRAFEGO
}

/// Ciclo de vida do cliente
enum ClienteStatus {
  NOVO
  ONBOARD
  ATIVO
  RENOVACAO
  INATIVO
}

/// Tipos de projeto (ate 3 por cliente)
enum TipoProjeto {
  MARKETING
  GESTAO
  FINANCEIRO
}

// ============================================================
// ORGANIZACAO & PESSOAS
// ============================================================

/// Config singleton — branding e parametros globais da Breakr.
model Config {
  id         String   @id @default(uuid())
  branding   Json?
  parametros Json?
  criadoEm   DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("config")
}

/// Usuario do sistema. Pertence a 1 cargo e N squads (via SquadMembro).
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  cargo     Cargo
  telefone  String?
  fotoUrl   String?  @map("foto_url")
  ativo     Boolean  @default(true)
  ultimoLoginEm DateTime? @map("ultimo_login_em")
  criadoEm  DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Departamento ao qual o usuario pertence (opcional na Fase 0)
  departamentoId String?      @map("departamento_id")
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])

  // Participacoes em squads (com funcao)
  squads SquadMembro[]

  // Notificacoes recebidas
  notificacoes Notificacao[]

  // Pecas de conteudo sob responsabilidade do usuario (Fase 2)
  conteudosResponsavel Conteudo[]   @relation("ConteudoResponsavel")
  avaliacoesRecebidas  Avaliacao[]  @relation("AvaliacaoResponsavel")

  // Leads sob responsabilidade do usuario (Fase 3 — comercial)
  leadsResponsavel Lead[] @relation("LeadResponsavel")

  // Back-office (Fase 3)
  comprasSolicitadas Compra[] @relation("CompraSolicitante")
  bugsResponsavel    Bug[]    @relation("BugResponsavel")

  // Otimizacoes de campanha registradas pelo usuario (Fase 2 — tráfego)
  otimizacoesCampanha OtimizacaoCampanha[] @relation("OtimizacaoAutor")

  // Itens de inventario sob responsabilidade do usuario (Fase 4 — interno)
  itensInventario ItemInventario[] @relation("ItemResponsavel")

  // Manifestacoes na ouvidoria (Fase 4 — RH)
  ouvidorias Ouvidoria[] @relation("OuvidoriaAutor")

  // Documentos e avaliacoes de desempenho do colaborador (Fase 4 — RH)
  documentos            DocumentoColaborador[] @relation("DocumentoColaborador")
  desempenhosRecebidos  AvaliacaoDesempenho[]  @relation("DesempenhoColaborador")
  desempenhosFeitos     AvaliacaoDesempenho[]  @relation("DesempenhoAvaliador")

  // Agenda (Fase 5 — interno): agendamentos de sala e dias de home office
  agendamentosSala AgendamentoSala[] @relation("AgendamentoSalaResponsavel")
  homeOffice       HomeOffice[]      @relation("HomeOfficeUsuario")

  // Agendamentos públicos recebidos (página de booking)
  agendamentosRecebidos AgendamentoColaborador[] @relation("AgendamentoColaborador")

  // Atendimento WhatsApp (M22)
  conversasAtendente Conversa[] @relation("ConversaAtendente")

  // Comunicados internos (autor)
  comunicados Comunicado[] @relation("ComunicadoAutor")

  // Chat interno
  mensagensChat MensagemChat[] @relation("MensagemChatAutor")

  @@index([departamentoId])
  @@map("usuario")
}

/// Departamento — Comercial, Sucesso do Cliente, Marketing, etc.
/// Hierarquia: Departamento -> Area -> Lista/Processo.
model Departamento {
  id       String   @id @default(uuid())
  nome     String   @unique
  criadoEm DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  areas    Area[]
  usuarios Usuario[]

  @@map("departamento")
}

/// Area — pertence a um Departamento, contem Listas.
model Area {
  id             String       @id @default(uuid())
  nome           String
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  criadoEm       DateTime     @default(now()) @map("criado_em")
  atualizadoEm   DateTime     @updatedAt @map("atualizado_em")

  listas Lista[]

  @@index([departamentoId])
  @@map("area")
}

/// Lista/Processo — pertence a uma Area.
model Lista {
  id           String   @id @default(uuid())
  nome         String
  ordem        Int      @default(0)
  areaId       String   @map("area_id")
  area         Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([areaId])
  @@map("lista")
}

/// Squad — time multifuncional (Trovao, Relampago, Fagulha...).
/// Usado na atribuicao automatica.
model Squad {
  id           String   @id @default(uuid())
  nome         String   @unique
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  membros   SquadMembro[]
  clientes  Cliente[]
  conteudos Conteudo[]

  @@map("squad")
}

/// Vinculo Usuario <-> Squad com a funcao desempenhada.
/// Regra: cada funcao e unica dentro de um squad (1 CS, 1 designer, etc.).
model SquadMembro {
  id        String      @id @default(uuid())
  squadId   String      @map("squad_id")
  squad     Squad       @relation(fields: [squadId], references: [id], onDelete: Cascade)
  usuarioId String      @map("usuario_id")
  usuario   Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  funcao    FuncaoSquad
  criadoEm  DateTime    @default(now()) @map("criado_em")

  // Uma funcao por squad (base deterministica da atribuicao automatica).
  @@unique([squadId, funcao])
  // Um usuario nao se repete no mesmo squad.
  @@unique([squadId, usuarioId])
  @@index([usuarioId])
  @@map("squad_membro")
}

// ============================================================
// CLIENTES
// ============================================================

/// Cliente — nome fantasia, tag (cor), status do ciclo, squad responsavel.
/// codigo_unico: gerado, garante rastreabilidade sistema <-> Meta Ads <-> docs.
model Cliente {
  id              String        @id @default(uuid())
  nomeFantasia    String        @map("nome_fantasia")
  tag             String?
  cnpj            String?
  email           String?
  telefone        String?
  status          ClienteStatus @default(NOVO)
  codigoUnico     String        @unique @map("codigo_unico")
  ticketMedio     Decimal?      @map("ticket_medio") @db.Decimal(12, 2)
  orcamentoMensal Decimal?      @map("orcamento_mensal") @db.Decimal(12, 2)
  // Link para a area de membros do cliente (exibido na tela de onboarding).
  linkAreaMembros String?       @map("link_area_membros")
  criadoEm        DateTime      @default(now()) @map("criado_em")
  atualizadoEm    DateTime      @updatedAt @map("atualizado_em")

  // 1 cliente -> 1 squad (opcional ate o onboarding).
  squadId String? @map("squad_id")
  squad   Squad?  @relation(fields: [squadId], references: [id])

  // Plano contratado (define valor e projetos a criar).
  planoId String? @map("plano_id")
  plano   Plano?  @relation(fields: [planoId], references: [id])

  // Grupo de WhatsApp do cliente — criado na ativacao (acao do motor).
  whatsappGrupoId String? @map("whatsapp_grupo_id")

  // Pipeline de entrada (Fase 1)
  contratos  Contrato[]
  faturas    Fatura[]
  projetos   Projeto[]
  onboarding Onboarding?

  // Onboarding do cliente — agenda de eventos e aulas concluidas (gamificacao).
  eventosOnboarding OnboardingEvento[]
  aulasConcluidas   AulaConclusao[]
  medalhas          ClienteMedalha[]

  // Operacao de marketing (Fase 2)
  conteudos Conteudo[]

  // Origem comercial (Fase 3) — leads que viraram este cliente.
  leadsOrigem Lead[] @relation("LeadCliente")

  // Tráfego pago (Fase 2 — M17)
  campanhas Campanha[]

  // Atendimento WhatsApp (M22)
  conversas Conversa[]

  @@index([squadId])
  @@index([status])
  @@map("cliente")
}

/// Plano contratado (Brasa, Hibrido...). Define valor, ciclo, entregaveis e
/// quais projetos sao criados automaticamente no onboarding.
model Plano {
  id           String        @id @default(uuid())
  nome         String        @unique
  valor        Decimal       @db.Decimal(12, 2)
  ciclo        String        @default("MENSAL")
  entregaveis  Json?
  tiposProjeto TipoProjeto[]
  ativo        Boolean       @default(true)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  clientes  Cliente[]
  contratos Contrato[]

  @@map("plano")
}

// ============================================================
// MOTOR DE AUTOMACAO (ver doc 03)
// ============================================================

/// Regra de automacao configuravel. Logica completa de trigger/condicoes/acoes
/// roda na Fase 1; aqui guardamos a estrutura como JSON.
model AutomacaoRule {
  id           String   @id @default(uuid())
  nome         String
  ativa        Boolean  @default(true)
  trigger      Json
  condicoes    Json?
  acoes        Json
  parametros   Json?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  execucoes JobExecution[]

  @@index([ativa])
  @@map("automacao_rule")
}

/// Execucao de um job do motor — observabilidade (substitui a tela do n8n).
model JobExecution {
  id        String   @id @default(uuid())
  status    String   @default("PENDENTE")
  payload   Json?
  resultado Json?
  erro      String?
  tentativas Int     @default(0)
  criadoEm  DateTime @default(now()) @map("criado_em")

  // Regra que originou a execucao (manual/cron pode nao ter regra).
  ruleId String?        @map("rule_id")
  rule   AutomacaoRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@index([status])
  @@map("job_execution")
}

// ============================================================
// SISTEMA
// ============================================================

/// Trilha de auditoria — ator, acao, entidade, dados (antes/depois).
model AuditLog {
  id       String   @id @default(uuid())
  ator     String
  acao     String
  entidade String
  dados    Json?
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([entidade])
  @@index([ator])
  @@map("audit_log")
}

/// Notificacao para um usuario (in-app). Realtime via WebSocket entra na proxima etapa.
/// tipo: INFO | ALERTA | SUCESSO | ERRO
model Notificacao {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo    String
  mensagem  String
  tipo      String   @default("INFO")
  link      String?
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([usuarioId, lida])
  @@map("notificacao")
}

// ============================================================
// PIPELINE DE ENTRADA — FASE 1
// Contrato -> Cobranca -> NF -> Onboarding -> Projetos auto-criados.
// Ver docs/escopo/modulos: 12-contratos, 13-financeiro, 14-cs-onboarding, 15-projetos.
// ============================================================

/// Ciclo de vida do contrato (M12).
enum StatusContrato {
  RASCUNHO              // criado a partir do formulario
  AGUARDANDO_ASSINATURA // enviado ao Autentique (stub)
  EM_REVISAO            // revisao interna antes de vigorar
  EM_VIGOR              // assinado e ativo (dispara a 1a cobranca)
  RENOVACAO             // 45 dias antes do vencimento
  ENCERRADO
}

/// Ciclo de vida da fatura/cobranca (M13 — ASAAS).
enum StatusFatura {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
  ESTORNADA
}

/// Contrato do cliente. Gerado do plano; assinado via Autentique (stub na Fase 1).
/// Ao entrar EM_VIGOR dispara a primeira cobranca (Fatura).
model Contrato {
  id                  String         @id @default(uuid())
  status              StatusContrato @default(RASCUNHO)
  valorMensal         Decimal        @map("valor_mensal") @db.Decimal(12, 2)
  codigoUnico         String         @unique @map("codigo_unico")
  docUrl              String?        @map("doc_url")
  autentiqueId        String?        @map("autentique_id")
  dataInicio          DateTime?      @map("data_inicio")
  vencimento          DateTime?
  renovacaoAutomatica Boolean        @default(true) @map("renovacao_automatica")
  criadoEm            DateTime       @default(now()) @map("criado_em")
  atualizadoEm        DateTime       @updatedAt @map("atualizado_em")

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  planoId String? @map("plano_id")
  plano   Plano?  @relation(fields: [planoId], references: [id])

  faturas Fatura[]

  @@index([clienteId])
  @@index([status])
  @@map("contrato")
}

/// Fatura/cobranca de um contrato. asaasId = id externo no ASAAS (stub na Fase 1).
/// Ao ser PAGA libera o onboarding e a criacao automatica dos projetos.
model Fatura {
  id              String       @id @default(uuid())
  valor           Decimal      @db.Decimal(12, 2)
  vencimento      DateTime
  status          StatusFatura @default(PENDENTE)
  asaasId         String?      @map("asaas_id")
  meio            String? // PIX | BOLETO | CARTAO
  notaFiscalId    String?      @map("nota_fiscal_id")
  notaFiscalUrl   String?      @map("nota_fiscal_url")
  enviadaWhatsapp Boolean      @default(false) @map("enviada_whatsapp")
  codigoUnico     String       @unique @map("codigo_unico")
  pagaEm          DateTime?    @map("paga_em")
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  contratoId String   @map("contrato_id")
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([contratoId])
  @@index([status])
  @@map("fatura")
}

/// Projeto do cliente — ate 3 (MARKETING, GESTAO, FINANCEIRO), criados do plano.
model Projeto {
  id           String      @id @default(uuid())
  tipo         TipoProjeto
  nome         String
  status       String      @default("ATIVO") // ATIVO | PAUSADO | ENCERRADO
  codigoUnico  String      @unique @map("codigo_unico")
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Um projeto por tipo por cliente (idempotencia da auto-criacao).
  @@unique([clienteId, tipo])
  @@index([clienteId])
  @@map("projeto")
}

/// Onboarding gamificado do cliente (1:1). Liberado apos o pagamento da 1a fatura.
model Onboarding {
  id           String   @id @default(uuid())
  progresso    Int      @default(0) // 0..100
  concluido    Boolean  @default(false)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  clienteId String  @unique @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  etapas OnboardingStep[]

  @@map("onboarding")
}

/// Etapa do onboarding (checklist gamificado).
model OnboardingStep {
  id        String   @id @default(uuid())
  titulo    String
  descricao String?
  // Link/material da etapa (ex.: formulario, pasta de referencias).
  link      String?
  ordem     Int      @default(0)
  concluido Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  onboardingId String     @map("onboarding_id")
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@map("onboarding_step")
}

/// Evento da agenda do cliente no onboarding (coleta de dados, reuniao de
/// onboarding, alinhamento...). `oQueLevar` = checklist do que ter em maos.
model OnboardingEvento {
  id        String   @id @default(uuid())
  titulo    String
  descricao String?
  data      DateTime
  oQueLevar String?  @map("o_que_levar")
  // Link do Google Meet (gerado opcionalmente ao criar a reuniao).
  meetLink  String?  @map("meet_link")
  criadoEm  DateTime @default(now()) @map("criado_em")

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("onboarding_evento")
}

/// Aula do onboarding educativo (player embutido apontando p/ video unlisted).
/// Catalogo global; o progresso por cliente vive em AulaConclusao.
model Aula {
  id        String   @id @default(uuid())
  titulo    String
  descricao String?
  videoUrl  String   @map("video_url")
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  conclusoes AulaConclusao[]

  @@map("aula")
}

/// Marca que um cliente assistiu uma aula (entra no progresso/gamificacao).
model AulaConclusao {
  id          String   @id @default(uuid())
  concluidaEm DateTime @default(now()) @map("concluida_em")

  aulaId String @map("aula_id")
  aula   Aula   @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([aulaId, clienteId])
  @@index([clienteId])
  @@map("aula_conclusao")
}

// ============================================================
// FASE 3 — COMERCIAL / CRM (M11)
// ============================================================

/// Pipeline comercial de um lead (da prospeccao ao ganho/perda).
enum StatusLead {
  NOVO
  CONTATADO
  QUALIFICADO
  PROPOSTA
  GANHO
  PERDIDO
}

/// Lead comercial. Ao ser GANHO, vira um Cliente (conversao) com rastreio de origem.
model Lead {
  id            String     @id @default(uuid())
  nome          String
  empresa       String?
  email         String?
  telefone      String?
  origem        String? // Indicacao | Inbound | Scraping | Evento...
  status        StatusLead @default(NOVO)
  valorEstimado Decimal?   @map("valor_estimado") @db.Decimal(12, 2)
  observacao    String?
  codigoUnico   String     @unique @map("codigo_unico")
  criadoEm      DateTime   @default(now()) @map("criado_em")
  atualizadoEm  DateTime   @updatedAt @map("atualizado_em")

  responsavelId String?  @map("responsavel_id")
  responsavel   Usuario? @relation("LeadResponsavel", fields: [responsavelId], references: [id])

  // Preenchido na conversao (GANHO) — aponta para o Cliente criado.
  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation("LeadCliente", fields: [clienteId], references: [id])

  @@index([status])
  @@index([responsavelId])
  @@map("lead")
}

// ============================================================
// FASE 2 — OPERACAO DE MARKETING (M16 Conteudo · M18 Qualidade/Aprovacao)
// ============================================================

/// Tipo de peca de conteudo.
enum TipoConteudo {
  POST
  REELS
  STORY
  CARROSSEL
  VIDEO
  ARTIGO
}

/// Funil de producao (kanban). A aprovacao do cliente acontece no portal.
enum StatusConteudo {
  IDEIA
  ROTEIRO
  PRODUCAO
  REVISAO
  EM_ALTERACAO
  APROVACAO_CLIENTE
  AGENDADO
  LABORATORIO
  PUBLICADO
  ARQUIVADO
}

/// Peca de conteudo de um cliente, produzida por um squad. Percorre o funil e,
/// em APROVACAO_CLIENTE, aparece no portal para o cliente aprovar e avaliar.
model Conteudo {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String?
  tipo        TipoConteudo   @default(POST)
  status      StatusConteudo @default(IDEIA)
  // URL da midia (imagem/video/carrossel) exibida na aprovacao do cliente (B5, l.258).
  midiaUrl    String?        @map("midia_url")
  codigoUnico String         @unique @map("codigo_unico")
  dataAgendada DateTime?     @map("data_agendada")
  // Peca de trafego pago: ao ser aprovada vai p/ o laboratorio de criativos.
  paraTrafego Boolean        @default(false) @map("para_trafego")

  // Qualidade / aprovacao do cliente (M18)
  estrelas          Int? // 1..5 (avaliacao do cliente)
  comentarioCliente String?   @map("comentario_cliente")
  aprovadoEm        DateTime? @map("aprovado_em")
  reworkCount       Int       @default(0) @map("rework_count")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  squadId String? @map("squad_id")
  squad   Squad?  @relation(fields: [squadId], references: [id])

  // Responsavel pela peca (designer/editor/copy).
  responsavelId String?  @map("responsavel_id")
  responsavel   Usuario? @relation("ConteudoResponsavel", fields: [responsavelId], references: [id])

  avaliacoes  Avaliacao[]
  reworkLogs  ReworkLog[]

  @@index([clienteId])
  @@index([status])
  @@index([squadId])
  @@map("conteudo")
}

/// Avaliacao multi-dimensional pelo cliente apos aprovar uma peca (M18).
/// Cada dimensao e opcional para nao bloquear a aprovacao.
model Avaliacao {
  id                String   @id @default(uuid())
  qualidadeGrafica  Int?     @map("qualidade_grafica")  // 1..5
  qualidadeTexto    Int?     @map("qualidade_texto")     // 1..5
  facilidadeAprovar Int?     @map("facilidade_aprovar")  // 1..5
  comentario        String?
  criadoEm          DateTime @default(now()) @map("criado_em")

  conteudoId    String   @map("conteudo_id")
  conteudo      Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  // Responsavel avaliado (derivo do conteudo.responsavelId no momento da criacao).
  responsavelId String?  @map("responsavel_id")
  responsavel   Usuario? @relation("AvaliacaoResponsavel", fields: [responsavelId], references: [id])

  @@index([conteudoId])
  @@index([responsavelId])
  @@map("avaliacao")
}

/// Log de retrabalho (M18). Criado automaticamente toda vez que uma peca
/// volta para PRODUCAO, com a origem (INTERNO = revisao interna / EXTERNO = cliente).
model ReworkLog {
  id         String   @id @default(uuid())
  statusDe   String   @map("status_de")
  statusPara String   @map("status_para")
  origem     String   // INTERNO | EXTERNO
  comentario String?  // comentario do cliente (quando origem = EXTERNO)
  criadoEm   DateTime @default(now()) @map("criado_em")

  conteudoId String   @map("conteudo_id")
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)

  @@index([conteudoId])
  @@index([origem])
  @@map("rework_log")
}

// ============================================================
// FASE 3 — BACK-OFFICE (M19 RH · M20 Operacoes · M21 Desenvolvimento)
// ============================================================

/// Etapas do recrutamento (M19).
enum StatusCandidato {
  INSCRITO
  TRIAGEM
  ENTREVISTA
  TESTE
  APROVADO
  REPROVADO
}

/// Vaga aberta de recrutamento.
model Vaga {
  id           String   @id @default(uuid())
  titulo       String
  departamento String?
  descricao    String?
  aberta       Boolean  @default(true)
  codigoUnico  String   @unique @map("codigo_unico")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  candidatos Candidato[]

  @@map("vaga")
}

/// Candidato a uma vaga. Percorre o funil de recrutamento.
model Candidato {
  id           String          @id @default(uuid())
  nome         String
  email        String?
  telefone     String?
  status       StatusCandidato @default(INSCRITO)
  perfilDisc   String?         @map("perfil_disc") // resultado do teste DISC
  curriculoUrl String?         @map("curriculo_url")
  observacao   String?
  criadoEm     DateTime        @default(now()) @map("criado_em")
  atualizadoEm DateTime        @updatedAt @map("atualizado_em")

  vagaId String @map("vaga_id")
  vaga   Vaga   @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@index([vagaId])
  @@index([status])
  @@map("candidato")
}

/// Pergunta do teste DISC (editável pelo admin em Configurações). Cada pergunta
/// tem opções; cada opção mapeia para uma dimensão (D, I, S ou C). opcoes é um
/// JSON: [{ "texto": "...", "dimensao": "D|I|S|C" }, ...].
model DiscPergunta {
  id        String   @id @default(uuid())
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  enunciado String?
  opcoes    Json
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("disc_pergunta")
}

/// Status de uma solicitacao de compra (M20).
enum StatusCompra {
  SOLICITADA
  APROVADA
  COMPRADA
  RECEBIDA
  CANCELADA
}

/// Solicitacao de compra (operacoes/back-office).
model Compra {
  id           String       @id @default(uuid())
  descricao    String
  categoria    String?
  valor        Decimal      @db.Decimal(12, 2)
  fornecedor   String?
  status       StatusCompra @default(SOLICITADA)
  codigoUnico  String       @unique @map("codigo_unico")
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  solicitanteId String?  @map("solicitante_id")
  solicitante   Usuario? @relation("CompraSolicitante", fields: [solicitanteId], references: [id])

  @@index([status])
  @@map("compra")
}

/// Severidade de um bug (M21).
enum SeveridadeBug {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

/// Status de um bug no board de desenvolvimento.
enum StatusBug {
  ABERTO
  EM_ANDAMENTO
  EM_REVISAO
  RESOLVIDO
  FECHADO
}

/// Bug/tarefa do board de desenvolvimento interno.
model Bug {
  id           String        @id @default(uuid())
  titulo       String
  descricao    String?
  severidade   SeveridadeBug @default(MEDIA)
  status       StatusBug     @default(ABERTO)
  codigoUnico  String        @unique @map("codigo_unico")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  responsavelId String?  @map("responsavel_id")
  responsavel   Usuario? @relation("BugResponsavel", fields: [responsavelId], references: [id])

  @@index([status])
  @@map("bug")
}

// ============================================================
// FASE 2 — TRAFEGO PAGO + IA ASSISTIVA (M17)
// ============================================================

/// Status de uma campanha de tráfego.
enum StatusCampanha {
  RASCUNHO
  ATIVA
  PAUSADA
  ENCERRADA
}

/// Campanha de tráfego de um cliente (Meta Ads na transição = entrada manual /
/// stub; quando a credencial Meta entrar, um adapter preenche as métricas).
/// A IA assistiva gera sugestões de otimização sobre estas métricas.
model Campanha {
  id              String         @id @default(uuid())
  nome            String
  objetivo        String? // Conversões | Tráfego | Alcance | Engajamento
  status          StatusCampanha @default(RASCUNHO)
  orcamentoDiario Decimal?       @map("orcamento_diario") @db.Decimal(12, 2)
  gasto           Decimal?       @db.Decimal(12, 2)
  impressoes      Int            @default(0)
  cliques         Int            @default(0)
  conversoes      Int            @default(0)
  codigoUnico     String         @unique @map("codigo_unico")
  sugestoesIa     String?        @map("sugestoes_ia") // últimas sugestões geradas pela IA
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em")

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  otimizacoes OtimizacaoCampanha[]

  @@index([clienteId])
  @@index([status])
  @@map("campanha")
}

/// Registro de uma otimizacao feita numa campanha (historico). Cada ajuste vira
/// um registro com o que foi feito e o resultado/observacao — o "historico de
/// otimizacoes" do tráfego (ex.: "RAS medio era 14").
model OtimizacaoCampanha {
  id             String   @id @default(uuid())
  descricao      String
  resultado      String?
  // Tempo gasto na otimização (min), informado pelo gestor — alimenta o dashboard.
  duracaoMinutos Int?     @map("duracao_minutos")
  criadoEm       DateTime @default(now()) @map("criado_em")

  campanhaId String   @map("campanha_id")
  campanha   Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  autorId String?  @map("autor_id")
  autor   Usuario? @relation("OtimizacaoAutor", fields: [autorId], references: [id])

  @@index([campanhaId])
  @@map("otimizacao_campanha")
}

// ============================================================
// CONFIGURACOES — IA (provedores de LLM)
// ============================================================

/// Provedor de IA ativo do sistema.
enum ProvedorIa {
  OPENAI
  ANTHROPIC
  GEMINI
}

// ============================================================
// ATENDIMENTO — WhatsApp / Inbox (M22)
// ============================================================

/// Status de uma conversa de atendimento.
enum StatusConversa {
  PENDENTE
  ATENDENDO
  RESOLVIDO
}

/// Configuracao do canal WhatsApp (singleton).
/// accessToken nunca volta inteiro pela API (mascarado no service).
model ConfiguracaoWhatsapp {
  id                 String   @id @default("singleton")
  phoneNumberId      String?  @map("phone_number_id")
  accessToken        String?  @map("access_token")
  webhookVerifyToken String?  @map("webhook_verify_token")
  waBaId             String?  @map("waba_id")
  ativo              Boolean  @default(false)
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_whatsapp")
}

/// Conversa de atendimento (1 thread por numero ativo).
/// Vinculada a um Cliente quando o numero e conhecido; nula para numeros avulsos.
model Conversa {
  id           String         @id @default(uuid())
  status       StatusConversa @default(PENDENTE)
  waTelefone   String?        @map("wa_telefone")
  assunto      String?
  ultimaMsgEm  DateTime?      @map("ultima_msg_em")
  // CSAT do atendimento: nota 1-5 dada pelo cliente após a resolução.
  csatNota         Int?      @map("csat_nota")
  csatComentario   String?   @map("csat_comentario")
  csatRespondidoEm DateTime? @map("csat_respondido_em")
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  atendenteId String?  @map("atendente_id")
  atendente   Usuario? @relation("ConversaAtendente", fields: [atendenteId], references: [id])

  mensagens Mensagem[]

  @@index([clienteId])
  @@index([status])
  @@index([atendenteId])
  @@index([waTelefone])
  @@map("conversa")
}

/// Mensagem de uma conversa (inbound = cliente, outbound = atendente/sistema).
model Mensagem {
  id         String    @id @default(uuid())
  autor      String    // CLIENTE | ATENDENTE | SISTEMA
  direcao    String    // inbound | outbound
  tipo       String    @default("text") // text | image | audio | document
  texto      String?
  arquivoUrl String?   @map("arquivo_url")
  waMsgId    String?   @unique @map("wa_msg_id")
  entregueEm DateTime? @map("entregue_em")
  lidoEm     DateTime? @map("lido_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")

  conversaId String   @map("conversa_id")
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@map("mensagem")
}

/// Log de webhooks recebidos (observabilidade / idempotencia).
model WebhookLog {
  id         String   @id @default(uuid())
  fonte      String   // meta | vai
  payload    Json
  processado Boolean  @default(false)
  conversaId String?  @map("conversa_id")
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@map("webhook_log")
}

// ============================================================
// CONFIGURACOES — IA (provedores de LLM)
// ============================================================

/// Canal de comunicados internos — anúncios da administração para todos os colaboradores.
model Comunicado {
  id           String   @id @default(uuid())
  titulo       String
  corpo        String
  fixado       Boolean  @default(false)
  criadoEm    DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  autorId String?  @map("autor_id")
  autor   Usuario? @relation("ComunicadoAutor", fields: [autorId], references: [id])

  @@index([fixado])
  @@map("comunicado")
}

// ============================================================
// CHAT INTERNO
// ============================================================

enum TipoCanal {
  PUBLICO
  PRIVADO
}

/// Canal de chat interno (geral, avisos, random, etc.)
model CanalChat {
  id        String         @id @default(uuid())
  nome      String         @unique
  descricao String?
  tipo      TipoCanal      @default(PUBLICO)
  criadoEm  DateTime       @default(now()) @map("criado_em")
  mensagens MensagemChat[]

  @@map("canal_chat")
}

/// Mensagem de chat interno enviada por um membro em um canal.
model MensagemChat {
  id        String    @id @default(uuid())
  conteudo  String
  criadoEm  DateTime  @default(now()) @map("criado_em")
  editadoEm DateTime? @map("editado_em")
  canalId   String    @map("canal_id")
  canal     CanalChat @relation(fields: [canalId], references: [id], onDelete: Cascade)
  autorId   String?   @map("autor_id")
  autor     Usuario?  @relation("MensagemChatAutor", fields: [autorId], references: [id])

  @@index([canalId, criadoEm])
  @@map("mensagem_chat")
}

/// Configuracao de IA (singleton, id fixo "singleton"). Guarda as chaves dos 3
/// provedores e qual esta ativo. As chaves NUNCA voltam inteiras pela API
/// (sempre mascaradas) — ver IaConfigService.
model ConfiguracaoIa {
  id              String     @id @default("singleton")
  ativo           Boolean    @default(false)
  provedorAtivo   ProvedorIa @default(ANTHROPIC)
  openaiApiKey    String?    @map("openai_api_key")
  anthropicApiKey String?    @map("anthropic_api_key")
  geminiApiKey    String?    @map("gemini_api_key")
  modeloOpenai    String?    @map("modelo_openai")
  modeloAnthropic String?    @map("modelo_anthropic")
  modeloGemini    String?    @map("modelo_gemini")
  atualizadoEm    DateTime   @updatedAt @map("atualizado_em")

  @@map("configuracao_ia")
}

/// Reuniao interna do time (alinhamentos, dailies...). Independente de cliente.
model ReuniaoInterna {
  id        String   @id @default(uuid())
  titulo    String
  descricao String?
  data      DateTime
  meetLink  String?  @map("meet_link")
  // Tipo p/ cor na agenda: GESTAO | VENDAS | FINANCEIRO | ESTRATEGICA | OUTRO.
  tipo      String   @default("OUTRO")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("reuniao_interna")
}

/// Comunicado enviado a todos os clientes — vira banner fixado no portal e
/// (quando o WhatsApp oficial entrar) também é disparado no grupo do cliente.
model ComunicadoCliente {
  id       String   @id @default(uuid())
  mensagem String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("comunicado_cliente")
}

/// Item de inventario interno (equipamentos, materiais). Plaqueta = etiqueta de
/// patrimonio; recebidoEm marca quando o funcionario confirmou o recebimento.
model ItemInventario {
  id            String    @id @default(uuid())
  nome          String
  categoria     String?
  valor         Decimal?  @db.Decimal(12, 2)
  notaFiscalUrl String?   @map("nota_fiscal_url")
  plaqueta      String?
  recebidoEm    DateTime? @map("recebido_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")

  responsavelId String?  @map("responsavel_id")
  responsavel   Usuario? @relation("ItemResponsavel", fields: [responsavelId], references: [id])

  @@map("item_inventario")
}

/// Manifestação na central de ouvidoria (reclamações/denúncias do time → jurídico).
/// status: ABERTA | EM_ANALISE | RESOLVIDA. anonima oculta o autor para o jurídico.
model Ouvidoria {
  id        String   @id @default(uuid())
  assunto   String
  mensagem  String
  anonima   Boolean  @default(false)
  status    String   @default("ABERTA")
  resolucao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  autorId String?  @map("autor_id")
  autor   Usuario? @relation("OuvidoriaAutor", fields: [autorId], references: [id])

  @@map("ouvidoria")
}

/// Meta trimestral (OKR) do time. periodo no formato "2026-Q3". status:
/// EM_ANDAMENTO | CONCLUIDA | ATRASADA.
model MetaTrimestre {
  id        String   @id @default(uuid())
  titulo    String
  descricao String?
  periodo   String
  progresso Int      @default(0)
  status    String   @default("EM_ANDAMENTO")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("meta_trimestre")
}

/// Resposta de eNPS (NPS interno do time). nota 0..10, anônima por natureza.
model RespostaEnps {
  id         String   @id @default(uuid())
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("resposta_enps")
}

/// Feriado cadastrado pela gestão — aparece na agenda de todos (ninguém trabalha).
model Feriado {
  id       String   @id @default(uuid())
  data     DateTime @db.Date
  titulo   String
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("feriado")
}

/// Agendamento da sala de reuniões presencial. Apenas CS e admin/superadmin
/// podem agendar (RBAC no controller).
model AgendamentoSala {
  id       String   @id @default(uuid())
  titulo   String
  inicio   DateTime
  fim      DateTime
  criadoEm DateTime @default(now()) @map("criado_em")

  responsavelId String?  @map("responsavel_id")
  responsavel   Usuario? @relation("AgendamentoSalaResponsavel", fields: [responsavelId], references: [id])

  @@index([inicio])
  @@map("agendamento_sala")
}

/// Dia de home office de um colaborador (controle de presença).
model HomeOffice {
  id       String   @id @default(uuid())
  data     DateTime @db.Date
  criadoEm DateTime @default(now()) @map("criado_em")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("HomeOfficeUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, data])
  @@index([data])
  @@map("home_office")
}

/// Agendamento público de horário com um colaborador (página de booking).
model AgendamentoColaborador {
  id       String   @id @default(uuid())
  nome     String // quem agendou (cliente/lead)
  email    String?
  telefone String?
  assunto  String?
  inicio   DateTime
  fim      DateTime
  criadoEm DateTime @default(now()) @map("criado_em")

  colaboradorId String  @map("colaborador_id")
  colaborador   Usuario @relation("AgendamentoColaborador", fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId, inicio])
  @@map("agendamento_colaborador")
}

/// Medalha de gamificação (configurável). Concedida a clientes; aparece no portal.
model Medalha {
  id        String   @id @default(uuid())
  titulo    String
  icone     String? // emoji ou nome de ícone
  descricao String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  clientes ClienteMedalha[]

  @@map("medalha")
}

/// Medalha conquistada por um cliente.
model ClienteMedalha {
  id          String   @id @default(uuid())
  concedidaEm DateTime @default(now()) @map("concedida_em")

  medalhaId String  @map("medalha_id")
  medalha   Medalha @relation(fields: [medalhaId], references: [id], onDelete: Cascade)

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([medalhaId, clienteId])
  @@index([clienteId])
  @@map("cliente_medalha")
}

/// Cronograma de otimização (configurável): em que dia da semana o gestor otimiza
/// campanhas de cada objetivo. diaSemana: 0=domingo … 6=sábado.
model RegraOtimizacao {
  id        String   @id @default(uuid())
  diaSemana Int      @map("dia_semana")
  objetivo  String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("regra_otimizacao")
}

/// Critério de avaliação configurável por tipo (CSAT). tipo ex.: CAMPANHA, TEXTO,
/// CS, CONCILIACAO. label é a pergunta exibida ao cliente.
model CriterioAvaliacao {
  id       String   @id @default(uuid())
  tipo     String
  label    String
  ordem    Int      @default(0)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([tipo])
  @@map("criterio_avaliacao")
}

/// Conta a pagar (financeiro interno). categoria é texto livre por enquanto;
/// a estrutura de centro de custo será definida com a gestora financeira.
model ContaPagar {
  id         String    @id @default(uuid())
  descricao  String
  categoria  String?
  valor      Decimal   @db.Decimal(12, 2)
  vencimento DateTime
  pago       Boolean   @default(false)
  pagoEm     DateTime? @map("pago_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")

  @@index([pago])
  @@map("conta_pagar")
}

/// Documento do colaborador (holerite, folha, contrato, manual). Por link +
/// assinatura: o colaborador assina dentro do sistema (assinadoEm). tipo:
/// HOLERITE | FOLHA | CONTRATO | MANUAL | OUTRO. competencia ex.: "2026-06".
model DocumentoColaborador {
  id          String    @id @default(uuid())
  tipo        String
  titulo      String
  url         String
  competencia String?
  assinadoEm  DateTime? @map("assinado_em")
  criadoEm    DateTime  @default(now()) @map("criado_em")

  colaboradorId String  @map("colaborador_id")
  colaborador   Usuario @relation("DocumentoColaborador", fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId])
  @@map("documento_colaborador")
}

/// Avaliação de desempenho de um colaborador num período (ex.: 2026-Q3).
model AvaliacaoDesempenho {
  id         String   @id @default(uuid())
  periodo    String
  nota       Int?
  comentario String
  criadoEm   DateTime @default(now()) @map("criado_em")

  colaboradorId String  @map("colaborador_id")
  colaborador   Usuario @relation("DesempenhoColaborador", fields: [colaboradorId], references: [id], onDelete: Cascade)

  avaliadorId String?  @map("avaliador_id")
  avaliador   Usuario? @relation("DesempenhoAvaliador", fields: [avaliadorId], references: [id])

  @@index([colaboradorId])
  @@map("avaliacao_desempenho")
}

/// Curso/treinamento disponibilizado para o time (link externo — Hotmart etc.).
model CursoEducacional {
  id         String   @id @default(uuid())
  titulo     String
  descricao  String?
  url        String
  plataforma String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("curso_educacional")
}
