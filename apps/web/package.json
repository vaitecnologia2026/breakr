{
  "name": "@breakr/web",
  "version": "0.1.0",
  "private": true,
  "description": "Breakr OS — Web (React + Vite + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "./scripts/cap-sync.sh",
    "cap:sync:android": "./scripts/cap-sync.sh android",
